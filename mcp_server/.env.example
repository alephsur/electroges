# ElectroGes API connection
ELECTROGES_API_URL=http://localhost:8000

# Credentials of the ElectroGes user the MCP server will act as.
# Use a dedicated service account with the minimum required role.
ELECTROGES_EMAIL=admin@electroges.dev
ELECTROGES_PASSWORD=change_me

# Transport mode:
#   stdio             — Claude Code / Claude Desktop (local subprocess)
#   streamable-http   — Railway / remote deployment (Hermes default)
#   sse               — legacy SSE, add 'transport: sse' in Hermes config
MCP_TRANSPORT=stdio

# SSE mode only — host and port to listen on
MCP_HOST=0.0.0.0
MCP_PORT=8080

# Bearer token that protects the /sse endpoint in SSE mode.
# Generate with: openssl rand -hex 32
# Leave empty to disable auth (stdio / local dev only).
MCP_BEARER_TOKEN=
